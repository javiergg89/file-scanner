<Window
    x:Class="FileScanner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FileScanner.Core"
    xmlns:local="using:FileScanner"
    xmlns:s="using:FileScanner.Strings"
    Title="File Scanner">

    <Grid x:Name="Root" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged" PointerPressed="Root_PointerPressed" RowDefinitions="Auto,Auto,Auto,*"
          AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <!-- The right panel width grows with the Windows text size (ApplyTextScale). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SideColumn" Width="440" />
        </Grid.ColumnDefinitions>
        <!-- On Root so Backspace goes up in whichever panel is in use (map or breakdown). -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Back" Invoked="Back_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="Cell" TargetType="StackPanel">
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="Spacing" Value="4" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="Big" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <!-- Size and file count boxes under the path. -->
            <Style x:Key="StatBox" TargetType="StackPanel">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <!-- For error texts created in code: theme colors cannot be looked up by key in Root.Resources. -->
            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
            <!-- Footer buttons: two per row at equal width so they fit with enlarged text. -->
            <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="FooterAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <!-- List rows that take focus (Tab and arrows) without the ListView padding and selection. -->
            <Style x:Key="RowItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="16,4,16,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <DataTemplate x:Key="RecTemplate" x:DataType="core:Recommendation">
                <Grid Padding="16,8,8,8" ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent"
                      DoubleTapped="Rec_DoubleTapped"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="RecCheck_Click"
                              AutomationProperties.Name="{x:Bind Title}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DisplayPath, Mode=OneWay}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Click="RecOpen_Click" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="{x:Bind local:MainWindow.OpenLabel(Title)}"
                            ToolTipService.ToolTip="{x:Bind s:Main.RecOpenTip}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GrowthTemplate" x:DataType="local:GrowthItem">
                <Grid Padding="16,8" ColumnSpacing="8" ColumnDefinitions="*,Auto"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Node.Path}">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DisplayPath}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind GrowthText}" Style="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DuplicateFileTemplate" x:DataType="local:DuplicateFileItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Background="Transparent" ContextRequested="DuplicateFile_ContextRequested">
                    <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="DuplicateCheck_Click"
                              AutomationProperties.Name="{x:Bind File.Path}" AutomationProperties.HelpText="{x:Bind CoveredText, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayPath}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind File.Path}" />
                    <!-- Empty unless a recommendation deletes this copy. -->
                    <TextBlock Grid.Column="2" Text="{x:Bind CoveredText, Mode=OneWay}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind DateText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DuplicateGroupTemplate" x:DataType="local:DuplicateGroupItem">
                <StackPanel Padding="0,8" Spacing="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind WastedText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Button Grid.Column="2" Content="{x:Bind s:Main.NotDuplicateButton}" Click="IgnoreGroup_Click" Padding="8,2" FontSize="12"
                                ToolTipService.ToolTip="{x:Bind s:Main.NotDuplicateTip}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Files}" ItemTemplate="{StaticResource DuplicateFileTemplate}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="JobTemplate" x:DataType="local:DeleteJob">
                <StackPanel Padding="0,6" Spacing="4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="EntryTemplate" x:DataType="local:EntryItem">
                <Grid Padding="4,4,0,4" ColumnSpacing="8" ColumnDefinitions="Auto,Auto,*,Auto,32" Background="Transparent"
                      DoubleTapped="Entry_DoubleTapped">
                    <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="EntryCheck_Click"
                              AutomationProperties.Name="{x:Bind Entry.Name}" />
                    <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Entry.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Entry.Path}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Click="EntryOpen_Click" Style="{StaticResource IconButton}" Visibility="{x:Bind FolderVisibility}"
                            AutomationProperties.Name="{x:Bind local:MainWindow.EnterLabel(Entry.Name)}" ToolTipService.ToolTip="{x:Bind s:Main.EnterTip}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SearchTemplate" x:DataType="local:SearchHit">
                <Grid Padding="0,4" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Folder}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TypeTemplate" x:DataType="local:TypeItem">
                <Grid Padding="0,6" ColumnSpacing="12" ColumnDefinitions="80,*,Auto,Auto,Auto">
                    <!-- Share of the folder total: the full bar is 100 %. -->
                    <Border Width="{x:Bind BarWidth}" Height="8" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{x:Bind Brush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind ShareText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Style="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LargestTemplate" x:DataType="local:LargestItem">
                <Grid Padding="4,4,0,4" ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Transparent">
                    <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="LargestCheck_Click"
                              AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind CoveredText, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind File.Path}">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Folder}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- Empty unless a recommendation deletes this file. -->
                    <TextBlock Grid.Column="2" Text="{x:Bind CoveredText, Mode=OneWay}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind DateText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Style="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <!-- Same columns as the List tab header (FolderListHeader). -->
            <DataTemplate x:Key="FolderRowTemplate" x:DataType="local:FolderRow">
                <Grid MinHeight="36" ColumnDefinitions="*,120,90,90,110" Background="Transparent">
                    <Grid Margin="8,0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center"
                          ToolTipService.ToolTip="{x:Bind Path}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <!-- Share of the breadcrumb folder total: the full bar is 100 %. -->
                    <Grid Grid.Column="1" Margin="8,0" ColumnDefinitions="56,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <Border Width="{x:Bind BarWidth}" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ShareText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="2" Margin="8,0" Text="{x:Bind SizeText}" Style="{StaticResource Mono}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Margin="8,0" Text="{x:Bind FilesText}" Style="{StaticResource Mono}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Margin="8,0" Text="{x:Bind DateText}" Style="{StaticResource Mono}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>
            <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar" Grid.ColumnSpan="2" Title="File Scanner">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                    <Button x:Name="QueueButton" Visibility="Collapsed" ToolTipService.ToolTip="{x:Bind s:Main.QueueTitle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="QueueRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="QueueText" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="400" Spacing="8">
                                    <TextBlock Text="{x:Bind s:Main.QueueTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                                               Text="{x:Bind s:Main.QueueHint}" />
                                    <ScrollViewer MaxHeight="360">
                                        <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource JobTemplate}" />
                                    </ScrollViewer>
                                    <Button Content="{x:Bind s:Main.ClearFinishedButton}" Click="ClearFinished_Click" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="RecycleButton" Click="EmptyRecycle_Click" ToolTipService.ToolTip="{x:Bind s:Main.RecycleTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="RecycleText" Text="{x:Bind s:Main.RecycleButton}" />
                        </StackPanel>
                    </Button>
                    <!-- The user checks several folders; "Escanear" scans them all in one pass. -->
                    <DropDownButton x:Name="ScopeButton" IsEnabled="False" ToolTipService.ToolTip="{x:Bind s:Main.ScopeTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="14" />
                            <TextBlock x:Name="ScopeText" Text="{x:Bind s:Main.ScopeHome}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout x:Name="ScopeFlyout" Placement="Bottom" Opening="ScopeFlyout_Opening">
                                <StackPanel MinWidth="300" Spacing="4">
                                    <TextBlock Text="{x:Bind s:Main.ScopeTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <CheckBox x:Name="ScopeHome" Content="{x:Bind s:Main.ScopeHome}" />
                                    <CheckBox x:Name="ScopeProgramFiles" Content="{x:Bind s:Main.ScopeProgramFiles}" />
                                    <CheckBox x:Name="ScopeProgramFilesX86" Content="{x:Bind s:Main.ScopeProgramFilesX86}" />
                                    <CheckBox x:Name="ScopeProgramData" Content="ProgramData" />
                                    <StackPanel x:Name="DrivePanel" Spacing="4" Padding="0,4,0,0" BorderThickness="0,1,0,0"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <!-- Folders added with "Elegir carpeta…", by drag and drop, or by opening from Explorer. -->
                                    <StackPanel x:Name="FolderPanel" Spacing="4" />
                                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" Margin="0,4,0,0"
                                               Text="{x:Bind s:Main.DragFolderHint}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                        <Button Click="PickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                                <TextBlock Text="{x:Bind s:Main.PickFolderButton}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Content="{x:Bind s:Main.ScanButton}" Click="ScopeScan_Click" Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="RescanButton" Click="Rescan_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{x:Bind s:Main.RescanButton}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{x:Bind s:Settings.Button}" ToolTipService.ToolTip="{x:Bind s:Settings.Button}">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutSubItem Text="{x:Bind s:Settings.Appearance}">
                                    <RadioMenuFlyoutItem x:Name="ThemeSystem" GroupName="Theme" Text="{x:Bind s:Settings.ThemeSystem}" Click="Theme_Click" />
                                    <RadioMenuFlyoutItem x:Name="ThemeLight" GroupName="Theme" Text="{x:Bind s:Settings.ThemeLight}" Click="Theme_Click" />
                                    <RadioMenuFlyoutItem x:Name="ThemeDark" GroupName="Theme" Text="{x:Bind s:Settings.ThemeDark}" Click="Theme_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="{x:Bind s:Settings.Language}">
                                    <RadioMenuFlyoutItem x:Name="LanguageEnglish" GroupName="Language" Text="{x:Bind s:Settings.LanguageEnglish}" Click="Language_Click" />
                                    <RadioMenuFlyoutItem x:Name="LanguageSpanish" GroupName="Language" Text="{x:Bind s:Settings.LanguageSpanish}" Click="Language_Click" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="16,0,16,12">
            <Grid ColumnDefinitions="*,*,*,*">
                <StackPanel Style="{StaticResource Cell}"
                            ToolTipService.ToolTip="{x:Bind s:Main.FreeAfterTip}">
                    <TextBlock Text="{x:Bind s:Main.FreeAfterLabel}" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="FreeText" Text="—" Style="{StaticResource Big}" />
                        <TextBlock x:Name="FreeDelta" Style="{StaticResource Mono}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource Cell}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind s:Main.SafeLabel}" Style="{StaticResource Label}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="SafeText" Text="—" Style="{StaticResource Big}" />
                        <TextBlock x:Name="SafeCount" Style="{StaticResource Mono}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource Cell}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind s:Main.ReviewAndLeftoversLabel}" Style="{StaticResource Label}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ReviewText" Text="—" Style="{StaticResource Big}" />
                        <TextBlock x:Name="ReviewCount" Style="{StaticResource Mono}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource Cell}">
                    <TextBlock Text="{x:Bind s:Main.NotScannedLabel}" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="OutsideText" Text="—" Style="{StaticResource Big}" />
                        <TextBlock x:Name="OutsideDetail" Text="{x:Bind s:Main.NotScannedDetail}" Style="{StaticResource Mono}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- App-wide notices; spans both columns. -->
        <InfoBar x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="2" Margin="16,0,16,12" />

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,0,6,16" Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <!-- Title row, tabs row below (in one row the tabs no longer fit at the default width). 16 px to the path row, as in Recommendations. -->
                <Grid x:Name="ExplorerHeader" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,0,0,8" SizeChanged="ExplorerHeader_SizeChanged">
                    <!-- The usage hint lives in a help button: as a text block next to the tabs it wrapped to six lines. -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind s:Main.DiskUsageTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Padding="6,4" VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind s:Main.ChartHelpName}"
                                ToolTipService.ToolTip="{x:Bind s:Main.ChartHelpTip}">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="4" MaxWidth="300">
                                        <TextBlock Text="{x:Bind s:Main.ChartHelpTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Main.ChartHelpClick}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Main.ChartHelpRightClick}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Main.ChartHelpUp}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <SelectorBar x:Name="ViewBar" Grid.Row="1" HorizontalAlignment="Left" SelectionChanged="ViewBar_SelectionChanged">
                        <SelectorBarItem x:Name="RingsItem" Text="{x:Bind s:Main.RingsTab}" AutomationProperties.Name="{x:Bind s:Main.RingsTab}" IsSelected="True">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xEB05;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="{x:Bind s:Main.MapTab}" AutomationProperties.Name="{x:Bind s:Main.MapTab}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xF0E2;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ListTab" Text="{x:Bind s:Main.ListTab}" AutomationProperties.Name="{x:Bind s:Main.ListTab}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="TypesItem" Text="{x:Bind s:Main.TypesTab}" AutomationProperties.Name="{x:Bind s:Main.TypesTab}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE7C3;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="LargestTab" Text="{x:Bind s:Main.LargestTab}" AutomationProperties.Name="{x:Bind s:Main.LargestTab}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8CB;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="DuplicatesItem" Text="{x:Bind s:Main.DuplicatesTab}" AutomationProperties.Name="{x:Bind s:Main.DuplicatesTab}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Width="220" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    PlaceholderText="{x:Bind s:Main.SearchPlaceholder}" QueryIcon="Find" TextMemberPath="Name" UpdateTextOnSelect="False"
                                    AutomationProperties.Name="{x:Bind s:Main.SearchName}" ItemTemplate="{StaticResource SearchTemplate}"
                                    ToolTipService.ToolTip="{x:Bind s:Main.SearchTip}"
                                    GotFocus="Search_GotFocus" TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted" />
                </Grid>

                <Grid x:Name="DuplicatesPanel" Grid.Row="1" Grid.RowSpan="3" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Visibility="Collapsed">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                        <Button x:Name="FindDuplicatesButton" Content="{x:Bind s:Main.FindDuplicatesButton}" Click="FindDuplicates_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <ComboBox x:Name="MinSizeBox" Grid.Column="1" SelectedIndex="1" VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Bind s:Main.MinSizeName}">
                            <ComboBoxItem Content="{x:Bind s:Main.MinSize1}" Tag="1" />
                            <ComboBoxItem Content="{x:Bind s:Main.MinSize10}" Tag="10" />
                            <ComboBoxItem Content="{x:Bind s:Main.MinSize100}" Tag="100" />
                        </ComboBox>
                        <Button x:Name="ExclusionsButton" Grid.Column="2" Content="{x:Bind s:Main.ExclusionsButton}" Click="Exclusions_Click"
                                ToolTipService.ToolTip="{x:Bind s:Main.ExclusionsTip}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="DuplicatesStatus" Style="{StaticResource Label}" TextWrapping="Wrap"
                                   Text="{x:Bind s:Main.DuplicatesIntro}" />
                        <ProgressBar x:Name="DuplicatesProgress" Visibility="Collapsed" />
                    </StackPanel>
                    <ListView x:Name="DuplicateList" Grid.Row="2" SelectionMode="None" ItemTemplate="{StaticResource DuplicateGroupTemplate}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <!-- Same layout as the Recommendations footer; acts only on the copies checked here. -->
                    <Grid Grid.Row="3" Padding="0,8,0,0" RowSpacing="8" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
                          BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBlock x:Name="DuplicateSelectionText" Grid.ColumnSpan="2" Style="{StaticResource Mono}" TextWrapping="Wrap"
                                   Text="{x:Bind s:Main.NoCopiesChecked}" />
                        <Button x:Name="MarkExtraButton" Grid.Row="1" Content="{x:Bind s:Main.MarkExtraButton}" Click="MarkExtra_Click" IsEnabled="False"
                                Style="{StaticResource FooterButton}"
                                ToolTipService.ToolTip="{x:Bind s:Main.MarkExtraTip}" />
                        <Button x:Name="DuplicateClearButton" Grid.Row="1" Grid.Column="1" Content="{x:Bind s:Main.UncheckAllButton}" Click="DuplicateClear_Click"
                                IsEnabled="False" Style="{StaticResource FooterButton}" />
                        <Button x:Name="DuplicateCopyButton" Grid.Row="2" Content="{x:Bind s:Main.CopyScriptButton}" Click="DuplicateCopy_Click" IsEnabled="False"
                                Style="{StaticResource FooterAccentButton}" />
                        <Button x:Name="DuplicateDeleteButton" Grid.Row="2" Grid.Column="1" Click="DuplicateDelete_Click" IsEnabled="False"
                                Style="{StaticResource FooterButton}" ToolTipService.ToolTip="{x:Bind s:Main.DeleteCopiesTip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="{x:Bind s:Main.DeleteButton}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="CrumbsRow" Grid.Row="1" Canvas.ZIndex="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="8" SizeChanged="CrumbsRow_SizeChanged">
                    <Button x:Name="UpButton" Click="Up_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="{x:Bind s:Main.UpName}" IsEnabled="False"
                            ToolTipService.ToolTip="{x:Bind s:Main.UpTip}">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <!-- Star column + right margin: the path shrinks first and never touches PathSize; long names trim. -->
                    <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" ItemClicked="Crumbs_ItemClicked">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="core:DirNode">
                                <TextBlock Text="{x:Bind Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                    <!-- Hovered chart shape: its path replaces the breadcrumb at once, without waiting for the tooltip. -->
                    <TextBlock x:Name="HoverPath" Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <!-- Same box on both sides, size above and file count below: hovered shape on the left, shown folder on the right. -->
                    <StackPanel x:Name="HoverInfo" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource StatBox}" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="HoverSize" Style="{StaticResource Mono}" />
                        <TextBlock x:Name="HoverFiles" Style="{StaticResource Mono}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- Last change (age colors) and growth since the saved snapshot, when there are any. -->
                        <TextBlock x:Name="HoverNote" Style="{StaticResource Mono}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="PathSize" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource StatBox}" HorizontalAlignment="Right">
                        <TextBlock x:Name="PathSizeText" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="PathFilesText" Style="{StaticResource Mono}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="MapHost" Grid.Row="2" SizeChanged="MapHost_SizeChanged">
                    <Canvas x:Name="MapCanvas" />
                    <StackPanel x:Name="BusyPanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" />
                        <TextBlock Text="{x:Bind s:Main.Scanning}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="BusyText" Style="{StaticResource Mono}" MaxWidth="520" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="{x:Bind s:Main.CancelButton}" Click="CancelScan_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <!-- Types tab: uses the breadcrumb row above and replaces the chart and legend. -->
                <Grid x:Name="TypesPanel" Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,*" RowSpacing="8" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TypesStatus" Style="{StaticResource Label}" TextWrapping="Wrap"
                                   Text="{x:Bind s:Main.TypesIntro}" />
                        <ProgressBar x:Name="TypesProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                    <ListView x:Name="TypeList" Grid.Row="1" SelectionMode="None" ItemTemplate="{StaticResource TypeTemplate}"
                              AutomationProperties.Name="{x:Bind s:Main.TypesListName}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                <!-- Largest tab: same layout as the Types tab. -->
                <Grid x:Name="LargestPanel" Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,*" RowSpacing="8" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LargestStatus" Style="{StaticResource Label}" TextWrapping="Wrap"
                                   Text="{x:Bind s:Main.LargestIntro}" />
                        <ProgressBar x:Name="LargestProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                    <ListView x:Name="LargestList" Grid.Row="1" SelectionMode="None" ItemTemplate="{StaticResource LargestTemplate}"
                              AutomationProperties.Name="{x:Bind s:Main.LargestListName}" ContextRequested="Largest_ContextRequested">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                <!-- List tab: same layout as the Types tab. -->
                <Grid x:Name="FolderListPanel" Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,*" Visibility="Collapsed">
                    <!-- Same padding as the rows (ItemContainerStyle) so the columns line up. -->
                    <Grid x:Name="FolderListHeader" Padding="12,0" ColumnDefinitions="*,120,90,90,110"
                          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Button x:Name="SortName" Tag="Name" Click="ListHeader_Click" Style="{StaticResource SortHeader}"
                                HorizontalContentAlignment="Left" Content="{x:Bind s:Main.NameColumn}" />
                        <Button x:Name="SortSize" Grid.Column="1" Grid.ColumnSpan="2" Tag="Size" Click="ListHeader_Click"
                                Style="{StaticResource SortHeader}" Content="{x:Bind s:Main.SizeColumn}" />
                        <Button x:Name="SortFiles" Grid.Column="3" Tag="Files" Click="ListHeader_Click" Style="{StaticResource SortHeader}"
                                Content="{x:Bind s:Main.FilesColumn}" />
                        <Button x:Name="SortModified" Grid.Column="4" Tag="Modified" Click="ListHeader_Click" Style="{StaticResource SortHeader}"
                                Content="{x:Bind s:Main.ModifiedColumn}" />
                    </Grid>
                    <ListView x:Name="FolderListView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="FolderList_ItemClick" ContextRequested="FolderList_ContextRequested"
                              ItemTemplate="{StaticResource FolderRowTemplate}" AutomationProperties.Name="{x:Bind s:Main.FolderContentsName}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock x:Name="FolderListEmpty" Grid.Row="1" Text="{x:Bind s:Main.EmptyFolder}" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
                <StackPanel x:Name="LegendPanel" Grid.Row="3" Spacing="4">
                    <!-- Equal-width column grid, filled in InitMap. VariableSizedWrapGrid ignored the cell width. -->
                    <Grid x:Name="Legend" ColumnSpacing="12" RowSpacing="4" SizeChanged="Legend_SizeChanged" />
                    <!-- Top margin: right under the legend, this row read as one more category. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,20,0,0">
                        <!-- Color by category or by age (MainWindow.Age.cs). -->
                        <ComboBox x:Name="ColorModeBox" SelectedIndex="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind s:Main.ColorModeName}"
                                  ToolTipService.ToolTip="{x:Bind s:Main.ColorModeTip}">
                            <ComboBoxItem Content="{x:Bind s:Main.ColorByCategory}" />
                            <ComboBoxItem Content="{x:Bind s:Main.ColorByAge}" />
                        </ComboBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ProgressRing x:Name="ScanRing" Width="14" Height="14" IsActive="False" />
                            <TextBlock x:Name="ScanInfo" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="CancelScanButton" Content="{x:Bind s:Main.CancelButton}" Click="CancelScan_Click" Padding="4,0"
                                             Visibility="Collapsed" ToolTipService.ToolTip="{x:Bind s:Main.CancelScanTip}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,16,16">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Padding="16,16,16,16">
                    <TextBlock Text="{x:Bind s:Main.RecommendationsTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="{x:Bind s:Main.RecommendationsHint}" />
                </StackPanel>

                <ScrollViewer x:Name="ListPanel" Grid.Row="1">
                    <StackPanel>
                        <!-- Shown until the first scan produces recommendations. -->
                        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="8" Padding="16,8">
                            <ProgressRing x:Name="LoadingRing" Width="16" Height="16" IsActive="True" />
                            <TextBlock x:Name="LoadingText" Text="{x:Bind s:Main.Analyzing}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="Sections" Visibility="Collapsed">
                            <Grid Padding="16,8" ColumnDefinitions="*,Auto">
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                    <TextBlock Text="{x:Bind s:Main.SafeLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                                <TextBlock x:Name="SafeTotal" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="SafeEmpty" Text="{x:Bind s:Main.NothingToClean}" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                            <ListView x:Name="SafeList" SelectionMode="None" ItemTemplate="{StaticResource RecTemplate}"
                                      ItemContainerStyle="{StaticResource RowItem}" ContextRequested="Rec_ContextRequested" />
                            <Grid Padding="16,16,16,8" ColumnDefinitions="*,Auto">
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                    <TextBlock Text="{x:Bind s:Main.ReviewFirstLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </Border>
                                <TextBlock x:Name="ReviewTotal" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="ReviewEmpty" Text="{x:Bind s:Main.NothingToClean}" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                            <ListView x:Name="ReviewList" SelectionMode="None" ItemTemplate="{StaticResource RecTemplate}"
                                      ItemContainerStyle="{StaticResource RowItem}" ContextRequested="Rec_ContextRequested" />
                            <StackPanel x:Name="LeftoverGroup" Visibility="Collapsed">
                                <Grid Padding="16,16,16,4" ColumnDefinitions="*,Auto">
                                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                        <TextBlock Text="{x:Bind s:Main.LeftoversTitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                    <TextBlock x:Name="LeftoverTotal" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="16,0,16,8" Style="{StaticResource Label}" TextWrapping="Wrap"
                                           Text="{x:Bind s:Main.LeftoversHint}" />
                                <ListView x:Name="LeftoverList" SelectionMode="None" ItemTemplate="{StaticResource RecTemplate}"
                                          ItemContainerStyle="{StaticResource RowItem}" ContextRequested="Rec_ContextRequested" />
                            </StackPanel>
                            <StackPanel x:Name="ManualGroup" Visibility="Collapsed">
                                <Grid Padding="16,16,16,8">
                                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                        <TextBlock Text="{x:Bind s:Main.ChosenByYouLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                    </Border>
                                </Grid>
                                <ListView x:Name="ManualList" SelectionMode="None" ItemTemplate="{StaticResource RecTemplate}"
                                          ItemContainerStyle="{StaticResource RowItem}" ContextRequested="Rec_ContextRequested" />
                            </StackPanel>
                            <!-- Informational; nothing here can be checked for deletion. RefreshGrowth fills it by comparing with the saved snapshot. -->
                            <StackPanel x:Name="GrowthGroup" Visibility="Collapsed">
                                <Grid Padding="16,16,16,4">
                                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock Text="{x:Bind s:Main.GrownLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="GrowthInfo" Margin="16,0,16,8" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                <ListView x:Name="GrowthList" SelectionMode="None" IsItemClickEnabled="True" ItemTemplate="{StaticResource GrowthTemplate}"
                                          ItemContainerStyle="{StaticResource RowItem}" AutomationProperties.Name="{x:Bind s:Main.GrownListName}"
                                          ItemClick="GrowthList_ItemClick" ContextRequested="GrowthList_ContextRequested" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DetailPanel" Grid.Row="1" RowDefinitions="Auto,*" Visibility="Collapsed">
                    <Grid Padding="8,0,16,8" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Button Click="DetailBack_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="{x:Bind s:Main.BackToRecommendations}" ToolTipService.ToolTip="{x:Bind s:Main.BackToRecommendations}">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <BreadcrumbBar x:Name="DetailCrumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="DetailCrumbs_ItemClicked" />
                    </Grid>
                    <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="None" ItemTemplate="{StaticResource EntryTemplate}" Padding="0,4"
                              ContextRequested="Entry_ContextRequested">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="36" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <!-- Shown when the open folder is empty (set by ShowLevelAsync). -->
                    <TextBlock x:Name="DetailEmpty" Grid.Row="1" Text="{x:Bind s:Main.EmptyFolder}" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                    <ProgressRing x:Name="DetailBusy" Grid.Row="1" IsActive="False" />
                </Grid>

                <Grid Grid.Row="2" Padding="16,12" RowSpacing="8" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
                      BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <TextBlock x:Name="SelectionText" Grid.ColumnSpan="2" Style="{StaticResource Mono}" TextWrapping="Wrap" Text="{x:Bind s:Main.NothingChecked}" />
                    <Button x:Name="SelectButton" Grid.Row="1" Content="{x:Bind s:Main.CheckSafeButton}" Click="SelectButton_Click" IsEnabled="False"
                            Style="{StaticResource FooterButton}" />
                    <Button x:Name="ClearButton" Grid.Row="1" Grid.Column="1" Content="{x:Bind s:Main.UncheckAllButton}" Click="DeselectAll_Click" IsEnabled="False"
                            Style="{StaticResource FooterButton}" />
                    <Button x:Name="CopyButton" Grid.Row="2" Content="{x:Bind s:Main.CopyScriptButton}" Click="Copy_Click" IsEnabled="False"
                            Style="{StaticResource FooterAccentButton}" />
                    <Button x:Name="DeleteButton" Grid.Row="2" Grid.Column="1" Click="DeleteSelection_Click" IsEnabled="False"
                            Style="{StaticResource FooterButton}" ToolTipService.ToolTip="{x:Bind s:Main.DeleteCheckedTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="DeleteButtonText" Text="{x:Bind s:Main.DeleteButton}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
